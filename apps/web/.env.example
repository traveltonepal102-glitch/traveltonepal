# Copy to .env.local (git-ignored) and fill in. Restart `pnpm dev` after changing these.

# Public address of this site, used for canonical URLs, sitemaps and JSON-LD.
SITE_URL=http://localhost:3000

# Google Maps JavaScript API (the /regions map). Leave empty to show the drawn map only.
# Restrict the key to this site's domains (HTTP referrers) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for the numbered pins). Empty uses Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
