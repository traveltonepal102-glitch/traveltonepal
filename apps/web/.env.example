# Copy to .env.local (git-ignored) and fill in. Restart `pnpm dev` after changing these.

# Public address of this site, used for canonical URLs, sitemaps and JSON-LD. Required where NEXT_PUBLIC_APP_ENV is
# production (Vercel: https://www.traveltonepal.com): without it every one of them names localhost.
SITE_URL=http://localhost:3000

# Google Maps JavaScript API (the /regions map). Leave empty to show the drawn map only.
# Restrict the key to this site's domains (HTTP referrers) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for the numbered pins). Empty uses Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Database (read-only): the website reads only the database's "web_" views (published content), on its server.
# Supabase > Project settings > API: the project URL and the publishable key. Never the secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Where library photos are served from. Empty: the Supabase "photos" bucket (CloudFront in production).
PHOTOS_PUBLIC_URL=

# The admin's password for /api/revalidate, which shows a save on the website at once. The same value as
# REVALIDATE_SECRET in apps/admin/.env; at least 32 characters (e.g. `openssl rand -hex 32`). Empty: the route
# is off and saved changes show within the hour.
REVALIDATE_SECRET=

# Which kind of deployment this is: production or development (empty = development). production turns on
# production-only features (now: Sentry error reports). Set production only on Vercel's Production environment.
NEXT_PUBLIC_APP_ENV=development

# Optional: error monitoring, reported only where NEXT_PUBLIC_APP_ENV is production.
# Sentry > traveltonepal-web > Settings > Client Keys (DSN). Not a secret (browsers get it).
# Empty: off. On Vercel also set SENTRY_AUTH_TOKEN (Sentry > Settings > Auth Tokens), so builds upload source maps;
# never put that token here.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, all three or none: the newsletter (Brevo). Without them the sign-up form is hidden in production.
# The API key needs only "Contacts: write" (Brevo › SMTP & API › API keys; turn IP blocking off: Vercel's addresses
# change). Server only: never in code or chat. The list is where confirmed subscribers go; the template is the
# "please confirm" email, whose button links to {{ doubleoptin }}.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_CONFIRM_TEMPLATE_ID=

# Optional: visit counts, loaded only where NEXT_PUBLIC_APP_ENV is production and only after a visitor allows
# "Analytics" in the cookie settings. Not secrets (browsers get them). Empty: that one is off.
# Google Analytics › Admin › Data streams › your web stream › Measurement ID (G-…).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity › your project › Settings › Overview › Project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
