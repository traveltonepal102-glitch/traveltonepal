# Copy to .env.local (git-ignored) and fill in. Restart `pnpm dev` after changing these.

# Public address of this site, used for canonical URLs, sitemaps and JSON-LD.
SITE_URL=http://localhost:3000

# Google Maps JavaScript API (the /regions map). Leave empty to show the drawn map only.
# Restrict the key to this site's domains (HTTP referrers) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for the numbered pins). Empty uses Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Database (read-only): the website reads only the database's "web_" views (published content), on its server.
# Supabase > Project settings > API: the project URL and the publishable key. Never the secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Where library photos are served from. Empty: the Supabase "photos" bucket (CloudFront in production).
PHOTOS_PUBLIC_URL=

# The admin's password for /api/revalidate, which shows a save on the website at once. The same value as
# REVALIDATE_SECRET in apps/admin/.env; at least 32 characters (e.g. `openssl rand -hex 32`). Empty: the route
# is off and saved changes show within the hour.
REVALIDATE_SECRET=
