# Copy to .env and fill in. Never commit .env.

# Local: postgres://<user>@localhost:5432/ttn_local
# Supabase: Project settings → Database → connection string (pooled)
DATABASE_URI=

# openssl rand -hex 32
PAYLOAD_SECRET=

# openssl rand -hex 32 — encrypts the admin's authenticator secret.
# Changing it makes the stored secret unreadable: reset 2FA afterwards.
TOTP_ENCRYPTION_KEY=
