# Copy to .env and fill in. Never commit .env.
# Server-only: the browser never talks to Supabase, so nothing here is NEXT_PUBLIC_.

# Supabase → Project Settings → Data API (URL) and API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_
# Bypasses Row Level Security; used only for the sign-in lock. Never share it or expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_

# Only for applying migrations (supabase db push), not used by the app.
# Supabase → Connect → Connection String → Session pooler. Write a "%" in the password as %25.
DATABASE_URI=

# Optional: the main website, linked as "View website" on the sign-in screen and refreshed after a save.
# e.g. http://localhost:3000 (plain http only for localhost; https:// elsewhere).
WEBSITE_URL=
# Optional: the same value as REVALIDATE_SECRET in apps/web/.env.local, at least 32 characters
# (e.g. `openssl rand -hex 32`). With WEBSITE_URL, a save shows on the website at once; empty: within the hour.
REVALIDATE_SECRET=

# Optional: where the sized photos are public, no trailing slash. Empty = Supabase Storage's "photos" bucket
# (development). Production: the CloudFront address, e.g. https://images.traveltonepal.com
PHOTOS_PUBLIC_URL=

# Optional, all four or none: photos and trek PDFs in one S3 bucket instead of Supabase Storage.
# Empty = Supabase Storage. With S3, PHOTOS_PUBLIC_URL must be the bucket's CloudFront address.
# The bucket keeps raw uploads and masters in private/, which its policy denies to CloudFront.
# The keys belong to an IAM user allowed only s3:PutObject, s3:GetObject and s3:DeleteObject on the bucket.
# The bucket needs a CORS rule allowing PUT from this admin's address (headers content-type, x-upsert).
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: error monitoring, reported only from Vercel's production deployment, so set it there.
# Sentry > traveltonepal-admin > Settings > Client Keys (DSN). Not a secret (browsers get it).
# Empty: off. On Vercel also set SENTRY_AUTH_TOKEN (Sentry > Settings > Auth Tokens), so builds upload source maps;
# never put that token here.
NEXT_PUBLIC_SENTRY_DSN=

# Admin logins are not set here: create them in the Supabase SQL Editor with supabase/create-admin-user.sql.
