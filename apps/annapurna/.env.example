# Annapurna Trekking's website. The same database as the admin; it reads only this website's published rows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Where library photos are served from; empty: the Supabase "photos" bucket.
PHOTOS_PUBLIC_URL=
# The same value as in the admin (at least 32 characters): a save shows at once. Empty: within the hour.
REVALIDATE_SECRET=
# This website's public address; empty: the dev server. Required when NEXT_PUBLIC_APP_ENV=production.
SITE_URL=
NEXT_PUBLIC_APP_ENV=
